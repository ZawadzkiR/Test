    def fail(self, ex):
        QMessageBox.critical(self, 'Błąd', str(ex))

    def choose_repo(self):
        folder = QFileDialog.getExistingDirectory(self, 'Wybierz lokalne repozytorium Git')
        if not folder:
            return
        try:
            repo = Path(git(folder, 'rev-parse', '--show-toplevel').strip()).resolve()
            self.repo = repo
            self.repo_label.setText(str(repo))
            logs = git(repo, 'log', '-n', '150', '--date=short', '--pretty=format:%H%x09%ad%x09%s')
            options = []
            for line in logs.splitlines():
                parts = line.split('\t', 2)
                if len(parts) == 3:
                    sha, date, subject = parts
                    options.append((f'{date}  {sha[:9]}  {subject[:65]}', sha))
            self.old.clear()
            self.new.clear()
            for label, sha in options:
                self.old.addItem(label, sha)
                self.new.addItem(label, sha)
            if self.old.count() > 1:
                self.old.setCurrentIndex(1)
            self.new.setCurrentIndex(0)
            self.load_files()
        except Exception as e:
            self.fail(e)

    def revisions(self):
        if not self.repo or not self.old.currentData() or not self.new.currentData():
            raise ValueError('Wybierz repozytorium oraz dwa commity.')
        if self.old.currentData() == self.new.currentData():
            raise ValueError('Wybierz różne commity.')
        return self.old.currentData(), self.new.currentData()

    def load_files(self):
        try:
            old, new = self.revisions()
            changed = git(self.repo, 'diff', '--name-only', '-z', '--find-renames', old, new)
            self.files.clear()
            for path in filter(None, changed.split('\0')):
                self.files.addItem(path)
            self.preview_area.setHtml('<p>Wybierz plik, aby zobaczyć zmiany.</p>')
            self.changes.clear()
            self._change_path = None
            self.statusBar().showMessage(f'{self.files.count()} zmienionych plików')
        except Exception as e:
            self.fail(e)

    def file_diff(self, path, mode=None):
        old, new = self.revisions()
        mode = mode or self.mode.currentData()
        context = '999999' if mode == 'full' else ('0' if mode == 'only' else mode)
        return git(self.repo, 'diff', '--no-ext-diff', '--no-color', '--find-renames',
                   f'--unified={context}', old, new, '--', path)

    def changed_lines(self, raw):
        self._loading_changes = True
        try:
            self.changes.clear()
            parent = None
            for i, line in enumerate(raw.splitlines()):
                if line.startswith('@@'):
                    parent = QTreeWidgetItem(self.changes, [line])
                    parent.setFlags(parent.flags() | Qt.ItemFlag.ItemIsUserCheckable)
                    parent.setCheckState(0, Qt.CheckState.Checked)
                elif parent is not None and (line.startswith('+') and not line.startswith('+++') or
                                               line.startswith('-') and not line.startswith('---')):
                    child = QTreeWidgetItem(parent, [line[:250]])
                    child.setData(0, Qt.ItemDataRole.UserRole, i)
                    child.setFlags(child.flags() | Qt.ItemFlag.ItemIsUserCheckable)
                    child.setCheckState(0, Qt.CheckState.Checked)
            self.changes.expandAll()
        finally:
            self._loading_changes = False

    def check_all_lines(self, checked):
        state = Qt.CheckState.Checked if checked else Qt.CheckState.Unchecked
        self._loading_changes = True
        try:
            for i in range(self.changes.topLevelItemCount()):
                parent = self.changes.topLevelItem(i)
                parent.setCheckState(0, state)
                for j in range(parent.childCount()):
                    parent.child(j).setCheckState(0, state)
        finally:
            self._loading_changes = False
        self.refresh_preview()

    def line_changed(self, item, column):
        if self._loading_changes:
            return
        self._loading_changes = True
        try:
            if item.parent() is None:
                for j in range(item.childCount()):
                    item.child(j).setCheckState(0, item.checkState(0))
            else:
                parent = item.parent()
                checked = sum(parent.child(j).checkState(0) == Qt.CheckState.Checked
                              for j in range(parent.childCount()))
                state = (Qt.CheckState.Checked if checked == parent.childCount() else
                         Qt.CheckState.Unchecked if checked == 0 else Qt.CheckState.PartiallyChecked)
                parent.setCheckState(0, state)
        finally:
            self._loading_changes = False
        self.refresh_preview()

    def selected_indexes(self):
        indexes = []
        total = 0
        for i in range(self.changes.topLevelItemCount()):
            parent = self.changes.topLevelItem(i)
            for j in range(parent.childCount()):
                child = parent.child(j)
                total += 1
                if child.checkState(0) == Qt.CheckState.Checked:
                    indexes.append(child.data(0, Qt.ItemDataRole.UserRole))
        return indexes, total

    def refresh_preview(self):
        if not self._change_path:
            return
        chosen, total = self.selected_indexes()
        try:
            if total and len(chosen) != total:
                shown = selected_diff(self._raw_diff, set(chosen))
                subtitle = '<p><b>Wybrane linie — fragment dokumentacyjny, nie pełny patch.</b></p>'
            else:
                shown = self.file_diff(self._change_path)
                subtitle = ''
            self.preview_area.setHtml(f'<h3>{esc(self._change_path)}</h3>' + subtitle +
                                      diff_html(shown, self.mode.currentData() == 'only'))
        except Exception as e:
            self.fail(e)

    def preview(self):
        items = self.files.selectedItems()
        if not items:
            return
        try:
            path = items[0].text()
            if self._change_path != path:
                self._change_path = path
                self._raw_diff = self.file_diff(path, 'only')
                self.changed_lines(self._raw_diff)
            self.refresh_preview()
        except Exception as e:
            self.fail(e)

    def bitbucket_url(self, rev):
        try:
            remote = git(self.repo, 'remote', 'get-url', 'origin').strip()
        except Exception:
            return ''
        if remote.startswith('git@bitbucket.org:'):
            remote = 'https://bitbucket.org/' + remote.partition(':')[2]
        elif remote.startswith('ssh://git@bitbucket.org/'):
            remote = 'https://bitbucket.org/' + remote.split('bitbucket.org/', 1)[1]
        if remote.startswith('https://bitbucket.org/'):
            # Never embed any possible credentials in a URL.
            return self._safe_bb_url(remote, rev)
        return ''

    @staticmethod
    def _safe_bb_url(remote, rev):
        from urllib.parse import urlsplit
        u = urlsplit(remote)
        if u.hostname != 'bitbucket.org':
            return ''
        path = u.path.removesuffix('.git').strip('/')
        if len(path.split('/')) < 2:
            return ''
        return f'https://bitbucket.org/{quote(path, safe="/")}/commits/{quote(rev)}'

    def add_selected(self):
        selected = self.files.selectedItems()
        if not selected:
            QMessageBox.information(self, 'Brak wyboru', 'Zaznacz plik lub kilka plików.')
            return
        try:
            old, new = self.revisions()
            date, author = git(self.repo, 'show', '-s', '--date=iso-strict', '--format=%aI%n%an', new).splitlines()[:2]
            for item in selected:
                path = item.text()
                diff = self.file_diff(path)
                if not diff.strip():
                    continue
                title, ok = QInputDialog.getText(self, 'Nazwa wykonanej pracy',
                    f'Nazwa pracy / modułu dla {path}:', text=Path(path).stem)
                if not ok:
                    break
                description, ok = QInputDialog.getMultiLineText(self,
                    'Opis pracy twórczej', 'Opis funkcjonalności / samodzielnego wkładu (opcjonalnie):')
                if not ok:
                    description = ''
                chosen_lines = None
                if path == self._change_path:
                    chosen, total = self.selected_indexes()
                    if total and len(chosen) != total:
                        if not chosen:
                            continue
                        diff = self._raw_diff
                        chosen_lines = chosen
                entry = dict(title=title.strip() or Path(path).stem, file=path,
                             repo=self.repo.name, date=date, author=author,
                             old=old, new=new, diff=diff, mode=self.mode.currentData(), description=description,
                             url=self.bitbucket_url(new), selected_lines=chosen_lines)
                self.entries.append(entry)
                self.report_list.addItem(f'{len(self.entries)}. {entry["title"]}  |  {path}')
            self.statusBar().showMessage(f'Pozycji w zestawieniu: {len(self.entries)}')
        except Exception as e:
            self.fail(e)

    def preview_report_entry(self):
        index = self.report_list.currentRow()
        if 0 <= index < len(self.entries):
            self.preview_area.setHtml(entry_html(self.entries[index], index+1))

    def remove_entry(self):
        i = self.report_list.currentRow()
        if i < 0:
            return
        self.entries.pop(i)
        self.report_list.clear()
        for n, e in enumerate(self.entries, 1):
            self.report_list.addItem(f'{n}. {e["title"]}  |  {e["file"]}')

    def save_project(self):
        path, _ = QFileDialog.getSaveFileName(self, 'Zapisz projekt', 'kup_evidence.json', 'JSON (*.json)')
        if path:
            try:
                Path(path).write_text(json.dumps({'title': self.heading.text(), 'entries': self.entries},
                                                ensure_ascii=False, indent=2), encoding='utf-8')
            except Exception as e:
                self.fail(e)

    def load_project(self):
        path, _ = QFileDialog.getOpenFileName(self, 'Otwórz projekt', '', 'JSON (*.json)')
        if not path:
            return
        try:
            data = json.loads(Path(path).read_text(encoding='utf-8'))
            if not isinstance(data.get('entries'), list):
                raise ValueError('Niepoprawny projekt.')
            self.entries = data['entries']
            self.heading.setText(data.get('title', 'Ewidencja zmian w kodzie źródłowym'))
            self.report_list.clear()
            for n, e in enumerate(self.entries, 1):
                self.report_list.addItem(f'{n}. {e["title"]}  |  {e["file"]}')
        except Exception as e:
            self.fail(e)

    def export_pdf(self):
        if not self.entries:
            QMessageBox.information(self, 'Puste zestawienie', 'Dodaj przynajmniej jeden plik.')
            return
        path, _ = QFileDialog.getSaveFileName(self, 'Zapisz raport PDF', 'ewidencja_kup.pdf', 'PDF (*.pdf)')
        if not path:
            return
        try:
            printer = QPrinter(QPrinter.PrinterMode.HighResolution)
            printer.setOutputFormat(QPrinter.OutputFormat.PdfFormat)
            printer.setOutputFileName(path)
            from PySide6.QtGui import QPageSize
            printer.setPageSize(QPageSize(QPageSize.PageSizeId.A4))
            printer.setPageMargins(QMarginsF(14, 15, 14, 15),
                                   QPrinter.Unit.Millimeter)
            doc = QTextDocument()
            doc.setDefaultFont(QFont('DejaVu Sans', 9))
            doc.setHtml(report_html(self.entries, self.heading.text()))
            doc.print_(printer)
            self.statusBar().showMessage(f'Zapisano PDF: {path}')
            QMessageBox.information(self, 'Gotowe', f'Zapisano raport:\n{path}')
        except Exception as e:
            self.fail(e)


def main():
    app = QApplication(sys.argv)
    app.setStyle('Fusion')
    window = MainWindow()
    window.show()
    sys.exit(app.exec())


if __name__ == '__main__':
    main()
