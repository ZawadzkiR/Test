def git(repo, *args):
    p = subprocess.run(['git', '-C', str(repo), *args], capture_output=True,
                       text=True, encoding='utf-8', errors='replace', timeout=90)
    if p.returncode:
        raise RuntimeError((p.stderr or p.stdout).strip()[:1200])
    return p.stdout


def esc(s):
    return html.escape(str(s), quote=True)


def diff_html(diff, only_changes=False):
    """Readable line-oriented diff; keep every line, including context."""
    parts = ['<table cellspacing="0" cellpadding="2" width="100%" '
             'style="font-family:monospace; font-size:8pt; border-collapse:collapse;">']
    for line in diff.splitlines():
        if only_changes and not (line.startswith('@@') or
                                 (line.startswith('+') and not line.startswith('+++')) or
                                 (line.startswith('-') and not line.startswith('---')) or
                                 line.startswith('\\ No newline')):
            continue
        if line.startswith(('diff --git ', 'index ', '--- ', '+++ ')):
            bg, fg = '#e5eaf1', '#3c4656'
        elif line.startswith('@@'):
            bg, fg = '#e8effe', '#264b9a'
        elif line.startswith('+'):
            bg, fg = '#e5f5e9', '#08672d'
        elif line.startswith('-'):
            bg, fg = '#fde8e8', '#a31826'
        else:
            bg, fg = '#ffffff', '#253041'
        safe = esc(line).replace(' ', '&nbsp;').replace('\t', '&nbsp;' * 4)
        # Chunk extremely long lines to avoid PDF clipping; do not discard characters.
        if len(line) > 140:
            chunks = [line[i:i+120] for i in range(0, len(line), 120)]
            safe = '<br/>'.join(esc(c).replace(' ', '&nbsp;').replace('\t', '&nbsp;'*4) for c in chunks)
        parts.append(f'<tr><td bgcolor="{bg}" style="color:{fg};">{safe or "&nbsp;"}</td></tr>')
    parts.append('</table>')
    return ''.join(parts)


def selected_diff(original, selected):
    """Display evidence excerpts (not an applicable git patch).

    Selected entries use original hunk ranges for traceability; the excerpt is
    expressly labeled as selective, not a complete patch.
    """
    lines = original.splitlines()
    out = []
    current_header = None
    body = []
    def flush():
        if body:
            out.append(current_header)
            out.extend(body)
    for i, line in enumerate(lines):
        if line.startswith('@@'):
            flush()
            current_header = line
            body = []
        elif current_header is None:
            out.append(line)
        elif i in selected and (line.startswith('+') or line.startswith('-')):
            body.append(line)
    flush()
    return '\n'.join(x for x in out if x is not None) + '\n'


def report_diff(e):
    if e.get('selected_lines') is not None:
        return selected_diff(e['diff'], set(e['selected_lines']))
    return e['diff']


def entry_html(e, number):
    url = e.get('url', '')
    link = f'<p><b>Bitbucket:</b> <a href="{esc(url)}">{esc(url)}</a></p>' if url else ''
    return (f'<h2 style="color:#14294d;">{number}. {esc(e["title"])}</h2>'
            f'<p><b>Plik:</b> {esc(e["file"])}<br/>'
            f'<b>Repozytorium:</b> {esc(e["repo"])}<br/>'
            f'<b>Data commita końcowego:</b> {esc(e["date"])}<br/>'
            f'<b>Autor commita:</b> {esc(e["author"])}<br/>'
            f'<b>Porównanie:</b> {esc(e["old"])} → {esc(e["new"])}<br/>'
            f'<b>Opis pracy:</b> {esc(e.get("description", ""))}</p>'
             + ('<p><i>Wybrane fragmenty zmian; nie jest to pełny patch Git.</i></p>' if e.get('selected_lines') is not None else '')
            + link + diff_html(report_diff(e), e.get('mode') == 'only' or e.get('selected_lines') is not None) + '<p>&nbsp;</p>')


def report_html(entries, heading):
    stamp = datetime.now().strftime('%Y-%m-%d %H:%M')
    return ('<!DOCTYPE html><html><head><meta charset="utf-8" /></head><body>'
            '<h1 style="color:#14294d;">' + esc(heading) + '</h1>'
            '<p>Dokumentacja zmian w kodzie źródłowym — materiał pomocniczy do ewidencji pracy twórczej.</p>'
            '<p><b>Wygenerowano:</b> ' + stamp + ' | <b>Pozycji:</b> ' + str(len(entries)) + '</p><hr/>'
            + ''.join(entry_html(e, i) for i, e in enumerate(entries, 1)) + '</body></html>')


